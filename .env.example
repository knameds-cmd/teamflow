# Firebase 설정 (선택 사항)
#
# 이 값들을 비워두면 앱은 "로컬 저장 모드"로 동작합니다
# (브라우저 localStorage에 저장, 같은 코드를 연 다른 탭끼리 동기화).
#
# 아래 6개 값을 모두 채우면 자동으로 "클라우드 실시간 공유 모드"(Firebase Firestore)로
# 전환되어, 서로 다른 기기/네트워크의 팀원이 같은 데이터를 실시간으로 함께 봅니다.
#
# 값은 Firebase 콘솔 → 프로젝트 설정 → 내 앱 → SDK 설정에서 복사합니다.
# (자세한 단계는 README의 "Firebase 설정" 참고)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
